let pointers=new Map(),dragOrigin=null,pinch=null;
svg.addEventListener('pointerdown',e=>{if(e.pointerType==='touch'&&!touchExplore)return;svg.setPointerCapture?.(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});lastDrag=false;if(pointers.size===1)dragOrigin={x:e.clientX,y:e.clientY};if(pointers.size===2){const a=[...pointers.values()];pinch={dist:Math.hypot(a[1].x-a[0].x,a[1].y-a[0].y),mid:{x:(a[0].x+a[1].x)/2,y:(a[0].y+a[1].y)/2},view:{...view}}}svg.classList.add('is-dragging')});
svg.addEventListener('pointermove',e=>{if(!pointers.has(e.pointerId))return;const prev=pointers.get(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===1){const dx=e.clientX-prev.x,dy=e.clientY-prev.y;if(dragOrigin&&Math.hypot(e.clientX-dragOrigin.x,e.clientY-dragOrigin.y)>6)lastDrag=true;panPixels(dx,dy)}else if(pointers.size===2&&pinch){lastDrag=true;const a=[...pointers.values()],dist=Math.hypot(a[1].x-a[0].x,a[1].y-a[0].y),mid={x:(a[0].x+a[1].x)/2,y:(a[0].y+a[1].y)/2};view={...pinch.view};const factor=pinch.dist/Math.max(10,dist);zoomAt(factor,pinch.mid.x,pinch.mid.y);panPixels(mid.x-pinch.mid.x,mid.y-pinch.mid.y)}});
function endPointer(e){pointers.delete(e.pointerId);if(!pointers.size){svg.classList.remove('is-dragging');dragOrigin=null;pinch=null;setTimeout(()=>lastDrag=false,50)}else if(pointers.size===1){const p=[...pointers.values()][0];dragOrigin={...p};pinch=null}}
svg.addEventListener('pointerup',endPointer);svg.addEventListener('pointercancel',endPointer);
svg.addEventListener('wheel',e=>{if(!(e.ctrlKey||e.metaKey))return;e.preventDefault();zoomAt(e.deltaY>0?1.12:.88,e.clientX,e.clientY)},{passive:false});
svg.addEventListener('dblclick',e=>{e.preventDefault();zoomAt(.72,e.clientX,e.clientY)});
document.querySelectorAll('[data-map-action]').forEach(btn=>btn.addEventListener('click',()=>{const a=btn.dataset.mapAction;if(a==='zoom-in')zoomAt(.8);if(a==='zoom-out')zoomAt(1.25);if(a==='home')setHome();if(a==='fit')fitAll();if(a==='explore'){touchExplore=!touchExplore;viewport.classList.toggle('is-exploring',touchExplore);exploreBtn.classList.toggle('active',touchExplore);exploreBtn.textContent=touchExplore?'✓ LISTO':'✋ MOVER'}if(a==='fullscreen'){if(document.fullscreenElement)document.exitFullscreen?.();else viewport.requestFullscreen?.()}}));
problemButtons.forEach(b=>b.addEventListener('click',()=>{const branch=mapNodes.find(n=>n.type==='branch'&&n.service===b.dataset.service);if(branch)selectNode(branch.id);else{const d=services[b.dataset.service]||services.custom;refs.code.textContent=d.code;refs.kicker.textContent=d.kicker;refs.title.textContent=d.title;refs.description.textContent=d.description;refs.includes.textContent=d.includes;refs.benefit.textContent=d.benefit;refs.format.textContent=d.format;refs.tags.innerHTML=d.tags.map(t=>`<span class="tag">${t}</span>`).join('');problemButtons.forEach(x=>x.classList.toggle('active',x===b))}}));
const ro=new ResizeObserver(()=>{const cx=view.x+view.w/2,cy=view.y+view.h/2;view.h=view.w/viewportAspect();view.y=cy-view.h/2;view.x=cx-view.w/2;clampView();applyView()});ro.observe(svg);
renderMap();setHome();selectNode('web');
const menuBtn=document.getElementById('menuBtn'),menu=document.getElementById('mobileMenu');if(menuBtn&&menu){menuBtn.addEventListener('click',()=>menu.classList.toggle('hidden'));menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>menu.classList.add('hidden')))}
})();
</script>
